# Supabase Configuration for Floor Ops Pro
# ==========================================
# Copy this file to .env.local and uncomment the ANON_KEY line
# 
# Project URL: https://supabase.com/dashboard/project/jiqogdiygvsetjxszfzb

# Required environment variables:
NEXT_PUBLIC_SUPABASE_URL=https://jiqogdiygvsetjxszfzb.supabase.co

# Use the project's publishable key (or legacy anon key):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# Example format: sb_publishable_...

# Optional: Service Role Key (for server-side operations with elevated privileges)
# Get from: https://supabase.com/dashboard/project/jiqogdiygvsetjxszfzb/settings/api-keys
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI Configuration (Required for FloorOps AI)
# ==========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
